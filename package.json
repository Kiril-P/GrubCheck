{
  "name": "grubcheck",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun --cwd apps/web dev",
    "dev:api": "bun --cwd apps/api dev",
    "dev:worker": "bun --cwd apps/worker dev",
    "build:web": "bun --cwd apps/web build",
    "build:api": "bun --cwd apps/api build",
    "build:worker": "bun --cwd apps/worker build",
    "build": "bun run build:web && bun run build:api && bun run build:worker",
    "test": "bun test",
    "check": "bun run test && bun x tsc --noEmit -p apps/web/tsconfig.json && bun x tsc --noEmit -p apps/api/tsconfig.json && bun x tsc --noEmit -p apps/worker/tsconfig.json",
    "db:generate": "bunx drizzle-kit generate",
    "db:push": "bunx drizzle-kit push"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^22.15.21",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.8.3"
  }
}
